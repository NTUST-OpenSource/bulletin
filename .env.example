# Copy to .env next to compose.yaml and fill in.

# The database password; it goes into a URL, so use hex: openssl rand -hex 24
POSTGRES_PASSWORD=

# Admin API bearer tokens: comma-separated name:token pairs. The name is recorded with each tier
# change. Tokens need 32 or more characters: openssl rand -hex 32
BULLETIN_ADMIN_TOKENS=owner:CHANGE_ME
